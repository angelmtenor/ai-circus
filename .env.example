# Default LLM provider to use (openai or google)
LLM_PROVIDER=google

# Default OpenAI model to use
OPENAI_MODEL=gpt-5.4-mini

# Default Google/Gemini model to use
GEMINI_MODEL=gemini-3-flash-preview

# API key for accessing OpenAI services for AI-related functionalities
OPENAI_API_KEY=

# API key for accessing Google services (e.g., Maps, Cloud)
GEMINI_API_KEY=

# API key for accessing Tavily services (e.g., data aggregation)
TAVILY_API_KEY=

# Language for the LLM responses
LLM_LANGUAGES=English
